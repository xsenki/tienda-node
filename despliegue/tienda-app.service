# Copiar a /etc/systemd/system/tienda-app.service
[Unit]
Description=Tienda DAW (Node.js)
After=network.target mariadb.service

[Service]
User=www-data
WorkingDirectory=/opt/tienda-app
ExecStart=/usr/bin/node server.js
Restart=on-failure
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
